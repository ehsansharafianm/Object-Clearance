<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obstacle Crossing Project"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experimenter Data Recording Form"
            android:textSize="15sp"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This form should be completed by the experimenter(s) in charge of the study. Make sure to fill out the form in its entirety."
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="14dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#3F51B5"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biomechanics Data"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Subject Height (cm)" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoHeight"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Subject Weight (kg)" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoWeight"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Hip to Knee Length (cm)" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoHipKnee"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Knee to Ankle Length (cm)" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoKneeAnkle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Hip to Ankle Length (cm) — measured" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoHipAnkle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Flat Foot Length (cm)" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoFlatFoot"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Elevated Foot Length (cm)" android:textSize="13sp" android:textColor="#555555"/>
        <EditText
            android:id="@+id/demoElevatedFoot"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Dominant Leg" android:textSize="13sp" android:textColor="#555555"/>
        <RadioGroup
            android:id="@+id/demoLegGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <RadioButton
                android:id="@+id/demoLegRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Right"
                android:textSize="14sp"
                android:textColor="#212121"
                android:buttonTint="#3F51B5"/>
            <RadioButton
                android:id="@+id/demoLegLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Left"
                android:textSize="14sp"
                android:textColor="#212121"
                android:buttonTint="#3F51B5"/>
        </RadioGroup>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Dominant Hand" android:textSize="13sp" android:textColor="#555555"/>
        <RadioGroup
            android:id="@+id/demoHandGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton
                android:id="@+id/demoHandRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Right"
                android:textSize="14sp"
                android:textColor="#212121"
                android:buttonTint="#3F51B5"/>
            <RadioButton
                android:id="@+id/demoHandLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Left"
                android:textSize="14sp"
                android:textColor="#212121"
                android:buttonTint="#3F51B5"/>
        </RadioGroup>

        <Button
            android:id="@+id/demoSaveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#4CAF50"
            android:text="Calculate and Save"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/demoResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#212121"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/demoCloseButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#9E9E9E"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

    </LinearLayout>
</ScrollView>
